PORT=5000
NODE_ENV=production
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devflow_crm
DB_USER=postgres
DB_PASSWORD=change-this
JWT_ACCESS_SECRET=replace-with-a-random-32-character-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-32-character-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CLIENT_URL=https://crm.example.com
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-this
SMTP_PASS=replace-this
SMTP_FROM=noreply@example.com
